<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <record id="view_move_form_apix_factoring" model="ir.ui.view">
        <field name="name">account.move.form.apix.factoring</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_post']" position="after">
                <button name="action_send_to_factoring"
                        type="object"
                        string="Send to factoring"
                        class="oe_highlight"
                        groups="account.group_account_invoice"
                        invisible="move_type not in ('out_invoice', 'out_refund') or state != 'posted' or factoring_state != 'not_sent' or date_einvoice_sent"/>
            </xpath>
            <xpath expr="//field[@name='invoice_date']" position="after">
                <field name="factoring_state" invisible="move_type not in ('out_invoice', 'out_refund')" readonly="True"/>
                <field name="date_factoring_sent" invisible="not date_factoring_sent" readonly="True"/>
            </xpath>
        </field>
    </record>

    <record id="action_send_invoices_to_factoring" model="ir.actions.server">
        <field name="name">Send to factoring</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">records.action_send_to_factoring()</field>
    </record>
</odoo>