<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <record id="view_company_form_apix_factoring" model="ir.ui.view">
        <field name="name">res.company.form.apix.factoring</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='vat']" position="after">
                <field name="factoring_edicode"/>
                <field name="factoring_einvoice_operator_id"/>
            </xpath>
        </field>
    </record>
</odoo>