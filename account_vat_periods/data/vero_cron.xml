<odoo noupdate="1">
    <record id="ir_cron_vero_api" model="ir.cron">
        <field name="name">Vero API: process confirmed submissions</field>
        <field name="model_id" ref="model_vero_api_submission" />
        <field name="state">code</field>
        <field
            name="code"
        >model.with_context(lang=env.user.lang or 'en_US')._cron_process()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True" />
    </record>
</odoo>
