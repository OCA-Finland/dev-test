msgstr "Sulje"

#. module: account_vat_periods
#. odoo-python
#: code:addons/account_vat_periods/wizards/vero_wizard.py:0
msgid "Close the VAT period before submitting the VAT return."
msgstr "Sulje ALV-kausi ennen ALV-ilmoituksen lähettämistä."

#. module: account_vat_periods
#: model:ir.model.fields,field_description:account_vat_periods.field_account_vat_period__closeable
