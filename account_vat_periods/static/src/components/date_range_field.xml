<?xml version="1.0" encoding="utf-8" ?>
<templates xml:space="preserve">
    <t t-inherit="mis_builder.MisReportWidget" t-inherit-mode="extension" owl="1">
        <xpath
            expr="//div[contains(@class, 'oe_mis_builder_filter_buttons')]"
            position="after"
        >
            <div
                class="custom-m2o-filter-container d-inline-block ms-2"
                style="width: 200px;"
            >
                <Many2XAutocomplete
                    resModel="customM2oState.resModel"
                    value="customM2oState.searchString"
                    update="(selection) => this.onCustomM2oUpdate(selection)"
                    getDomain="() => []"
                    isToMany="false"
                    fieldString="'VAT Period Filter'"
                    activeActions="{}"
                    placeholder="'Filter by VAT Period'"
                    t-if="showDateRange"
                />
            </div>
        </xpath>
    </t>
</templates>
