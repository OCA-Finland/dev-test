<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="account_vat_periods.VeroCredentials">
        <div class="o_action p-4 overflow-auto">
            <div class="d-flex gap-2 mb-3">
                <button class="btn btn-secondary" t-on-click="back" t-att-disabled="state.busy">Takaisin yhteyteen</button>
                <button class="btn btn-secondary" t-on-click="() => this.run('status')" t-att-disabled="state.busy">Päivitä tila</button>
                <button class="btn btn-primary" t-on-click="() => this.run('test_connection')" t-att-disabled="state.busy || !state.info">Testaa API-yhteys</button>
            </div>
            <h2>Vero API: avaimet ja varmenne</h2>
            <div t-if="state.error" class="alert alert-danger" role="alert"><t t-esc="state.error"/></div>
            <div t-if="state.success" class="alert alert-success" role="status"><t t-esc="state.success"/></div>
            <div t-if="state.busy" class="alert alert-info" role="status">Käsitellään. Älä lähetä samaa pyyntöä uudelleen.</div>
            <t t-if="state.info">
                <p><strong t-esc="state.info.company"/> · <t t-esc="state.info.name"/> · <strong t-esc="state.info.environment"/></p>
                <div t-if="state.info.environment === 'production'" class="alert alert-warning">TUOTANTO: varmennepyyntö koskee oikeaa yritystä ja käyttää kertakäyttöiset siirtotunnukset.</div>
                <section class="card p-3 mb-3">
                    <h3>Ohjelmiston API-avain</h3>
                    <p t-if="state.info.key_configured">Avain on määritetty. Alla voit korvata sen uudella avaimella. Tallennettua avainta ei näytetä.</p>
                    <p t-else="">API-avainta ei ole vielä määritetty.</p>
                    <p t-if="state.info.environment === 'sandbox'">Sandboxissa syötä palvelun subscription key.</p>
                    <label for="vero-software-key">Uusi API-avain</label>
                    <input id="vero-software-key" t-ref="softwareKey" type="password" autocomplete="new-password" spellcheck="false" class="form-control mb-2" maxlength="4096" t-att-disabled="state.busy"/>
                    <div><button class="btn btn-primary" t-on-click="saveKey" t-att-disabled="state.busy">Tallenna API-avain</button></div>
                </section>
                <section t-if="state.info.environment !== 'sandbox'" class="card p-3 mb-3">
                    <h3>Nykyinen varmenne</h3>
                    <p t-if="!state.info.certificate_configured">Varmennetta ei ole otettu käyttöön.</p>
                    <p t-if="state.info.certificate">Haltija: <strong t-esc="state.info.certificate.subject"/>. Voimassa asti: <t t-esc="state.info.certificate.expires"/>.</p>
                    <p t-if="state.info.certificate_error" class="text-danger" t-esc="state.info.certificate_error"/>
                    <h3>Tilatun varmenteen nouto</h3>
                    <p>Tilaa varmenne ensin Verohallinnon varmennepalvelusta. Syötä saamasi siirtotunnus ja kertakäyttösalasana. Yrityksen ALV-tunnisteen pitää vastata tilauksen haltijaa. Nouto ei vaihda nykyistä varmennetta ennen erillistä käyttöönottoa.</p>
                    <p>Yrityksen ALV-tunniste: <strong t-esc="state.info.vat || 'Puuttuu — täydennä yrityksen tiedot ensin'"/></p>
                    <div t-if="state.info.enrollment.phase" class="alert alert-info">
                        <strong>Noudon tila: <t t-esc="state.info.enrollment.phase"/></strong>
                        <p class="mb-0" t-esc="state.info.enrollment.message"/>
                    </div>
                    <t t-if="!['uncertain', 'waiting', 'ready'].includes(state.info.enrollment.phase)">
                        <label for="vero-transfer-id">Siirtotunnus</label>
                        <input id="vero-transfer-id" t-ref="transferId" type="password" autocomplete="new-password" spellcheck="false" maxlength="32" class="form-control mb-2" t-att-disabled="state.busy"/>
                        <label for="vero-transfer-password">Kertakäyttösalasana</label>
                        <input id="vero-transfer-password" t-ref="transferPassword" type="password" autocomplete="new-password" spellcheck="false" maxlength="16" class="form-control mb-2" t-att-disabled="state.busy"/>
                        <div><button class="btn btn-primary" t-on-click="submit" t-att-disabled="state.busy || !state.info.vat">Aloita tilatun varmenteen nouto</button></div>
                    </t>
                    <div class="d-flex gap-2 mt-2">
                        <button t-if="state.info.enrollment.phase === 'waiting'" class="btn btn-primary" t-on-click="() => this.run('retrieve')" t-att-disabled="state.busy">Nouda ja tarkista varmenne</button>
                        <button t-if="['ready', 'active'].includes(state.info.enrollment.phase)" class="btn btn-primary" t-on-click="() => this.run('activate')" t-att-disabled="state.busy">Ota noudettu varmenne käyttöön</button>
                    </div>
                    <p t-if="state.info.enrollment.expires" class="mt-2">Noudettu varmenne voimassa asti: <t t-esc="state.info.enrollment.expires"/>.</p>
                </section>
                <p class="text-muted">Avaimet säilyvät Odoo-palvelimen suojatussa hakemistossa. Yksityistä avainta ei palauteta selaimelle. Ylläpidon tulee sisällyttää avainhakemisto suojattuun varmuuskopiointiin. Avainten vaihtaminen ei vaadi Odoon uudelleenkäynnistystä.</p>
            </t>
        </div>
    </t>
</templates>
