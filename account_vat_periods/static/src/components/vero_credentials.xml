<?xml version='1.0' encoding='utf-8'?>
<templates xml:space="preserve">
    <t t-name="account_vat_periods.VeroCredentials">
        <div class="o_action p-4 overflow-auto">
            <div class="d-flex gap-2 mb-3">
                <button class="btn btn-secondary" t-on-click="back" t-att-disabled="state.busy">Back to connection</button>
                <button class="btn btn-secondary" t-on-click="() =&gt; this.run('status')" t-att-disabled="state.busy">Refresh status</button>
                <button class="btn btn-primary" t-on-click="() =&gt; this.run('test_connection')" t-att-disabled="state.busy || !state.info">Test API connection</button>
            </div>
            <h2>Vero API: keys and certificate</h2>
            <div t-if="state.error" class="alert alert-danger" role="alert"><t t-esc="state.error"/></div>
            <div t-if="state.success" class="alert alert-success" role="status"><t t-esc="state.success"/></div>
            <div t-if="state.busy" class="alert alert-info" role="status">Processing. Do not send the same request again.</div>
            <t t-if="state.info">
                <p><strong t-esc="state.info.company"/> · <t t-esc="state.info.name"/> · <strong t-esc="environmentLabel"/></p>
                <div t-if="state.info.production_blocked" class="alert alert-warning">Production traffic is disabled in this database copy. Test connections remain available. Only enable production if this is the intended live database.</div>
                <p t-if="state.info.storage_mode === 'database'">Encryption key management is automatic. Credentials and their encryption key are included in the database backup. Protect the complete backup as confidential data.</p>
                <p t-if="state.info.storage_mode === 'external'">This connection uses an external encryption key. Keep that key separately with your backups, or ask an administrator to switch to automatic key management below.</p>
                <div t-if="state.info.enrollment.phase === 'blocked'" class="alert alert-warning" role="alert"><t t-esc="state.info.enrollment.message"/></div>
                <div t-if="state.info.legacy_available" class="alert alert-info">
                    <p>Existing credential files were found. Import them into encrypted database storage to continue. The original files are kept unchanged. This does not send a new certificate request.</p>
                    <button class="btn btn-primary" t-att-disabled="state.busy || !state.info.storage_ready" t-on-click="() =&gt; this.run('migrate')">Import existing credentials</button>
                </div>
                <div t-if="state.info.environment === 'production'" class="alert alert-warning">PRODUCTION: this certificate request is for a real company and consumes the one-time transfer credentials.</div>
                <section class="card p-3 mb-3">
                    <h3>Software API key</h3>
                    <p t-if="state.info.key_configured">A key is configured. You can replace it below. The saved key is not displayed.</p>
                    <p t-else="">No API key has been configured.</p>
                    <p t-if="state.info.environment === 'sandbox'">For Sandbox, enter the service subscription key.</p>
                    <label for="vero-software-key">New API key <span class="fa fa-question-circle text-muted" title="Software key configured by your software provider; Sandbox uses its subscription key. Saving replaces the current key for this connection. The saved value is never displayed again." tabindex="0"/></label>
                    <input id="vero-software-key" t-ref="softwareKey" type="password" autocomplete="new-password" spellcheck="false" class="form-control mb-2" maxlength="4096" t-att-disabled="state.busy"/>
                    <div><button class="btn btn-primary" t-on-click="saveKey" t-att-disabled="state.busy || !state.info.storage_ready || state.info.legacy_available">Save API key</button></div>
                </section>
                <section t-if="state.info.environment !== 'sandbox'" class="card p-3 mb-3">
                    <h3>Current certificate</h3>
                    <p t-if="!state.info.certificate_configured">No certificate has been activated.</p>
                    <p t-if="state.info.certificate">Holder: <strong t-esc="state.info.certificate.subject"/>. Valid until: <t t-esc="state.info.certificate.expires"/>.</p>
                    <p t-if="state.info.certificate_error" class="text-danger" t-esc="state.info.certificate_error"/>
                    <h3>Retrieve an ordered certificate</h3>
                    <p>Order the certificate from the Finnish Tax Administration's Certificate Service first. Enter the transfer identifier and one-time password you received. The company VAT identifier must match the certificate holder. Retrieval does not replace the current certificate until you activate it separately.</p>
                    <p>Company VAT identifier: <strong t-esc="state.info.vat || missingVatLabel"/></p>
                    <div t-if="state.info.enrollment.phase" class="alert alert-info">
                        <strong>Retrieval status: <t t-esc="phaseLabel"/></strong>
                        <p class="mb-0" t-esc="state.info.enrollment.message"/>
                    </div>
                    <div t-if="state.info.enrollment.phase === 'blocked'" class="alert alert-warning" role="alert">
                        Certificate retrieval needs attention. Keep the existing request and its stored data. Ask your administrator to investigate the error, then use Refresh status to retry the saved response check. Do not delete the connection or start another request with the same transfer credentials. You can still manage the software API key and return to the connection settings.
                    </div>
                    <t t-if="state.info.storage_ready &amp;&amp; !state.info.legacy_available &amp;&amp; !['blocked', 'uncertain', 'waiting', 'ready'].includes(state.info.enrollment.phase)">
                        <label for="vero-transfer-id">Transfer identifier <span class="fa fa-question-circle text-muted" title="One-time transfer identifier from the Certificate Service message for this company and environment. Use it with the matching password within 14 days. A pending request must be continued instead of starting another one." tabindex="0"/></label>
                        <input id="vero-transfer-id" t-ref="transferId" type="password" autocomplete="new-password" spellcheck="false" maxlength="32" class="form-control mb-2" t-att-disabled="state.busy"/>
                        <label for="vero-transfer-password">One-time password <span class="fa fa-question-circle text-muted" title="One-time password delivered with the transfer identifier. It is sent securely to retrieve the ordered certificate and is not stored. Do not enter the Odoo login password or software API key here." tabindex="0"/></label>
                        <input id="vero-transfer-password" t-ref="transferPassword" type="password" autocomplete="new-password" spellcheck="false" maxlength="16" class="form-control mb-2" t-att-disabled="state.busy"/>
                        <div><button class="btn btn-primary" t-on-click="submit" t-att-disabled="state.busy || !state.info.vat">Start retrieving the ordered certificate</button></div>
                    </t>
                    <div class="d-flex gap-2 mt-2">
                        <button t-if="state.info.enrollment.phase === 'waiting'" class="btn btn-primary" t-on-click="() =&gt; this.run('retrieve')" t-att-disabled="state.busy">Retrieve and verify certificate</button>
                        <button t-if="['ready', 'active'].includes(state.info.enrollment.phase)" class="btn btn-primary" t-on-click="() =&gt; this.run('activate')" t-att-disabled="state.busy">Activate retrieved certificate</button>
                    </div>
                    <p t-if="state.info.enrollment.expires" class="mt-2">Retrieved certificate valid until: <t t-esc="state.info.enrollment.expires"/>.</p>
                </section>
                <details t-if="state.info.can_manage_storage" class="card p-3 mb-3">
                    <summary>Administrator: recovery and key management</summary>
                    <p class="mt-3">Automatic key management stores the encryption key in this database. Someone with a complete database copy can decrypt the credentials. Switching storage keeps the existing API key, certificate and pending certificate request.</p>
                    <label for="vero-recovery-key">Original encryption key (only for recovery)</label>
                    <input id="vero-recovery-key" t-ref="recoveryKey" type="password" autocomplete="new-password" spellcheck="false" maxlength="128" class="form-control mb-2" t-att-disabled="state.busy" title="Leave empty to use the current storage key. If it has been lost from the server configuration, enter the original Fernet encryption key to recover this connection. This is not the software API key. It is never returned to the browser."/>
                    <p class="text-danger">Reset permanently removes this connection's saved API key, private key, certificate and retrieval state. It does not revoke a certificate at Vero or cancel an already sent request. Do not reuse consumed transfer credentials. Other connections and accounting records are kept.</p>
                    <label for="vero-confirmation">Enter this connection's name to confirm</label>
                    <input id="vero-confirmation" t-ref="confirmation" class="form-control mb-2" autocomplete="off" t-att-disabled="state.busy"/>
                    <label class="mb-3"><input t-ref="acknowledge" type="checkbox" t-att-disabled="state.busy"/> I understand the consequences of the selected operation. For a reset, I accept losing the saved credentials and will resolve any earlier certificate request with Vero.</label>
                    <div class="d-flex flex-wrap gap-2">
                        <button class="btn btn-secondary" t-att-disabled="state.busy" t-on-click="() =&gt; this.maintenance('use_database_key')">Use automatic key management / recover</button>
                        <button class="btn btn-outline-danger" t-att-disabled="state.busy" t-on-click="() =&gt; this.maintenance('reset_credentials')">Reset this connection's credentials</button>
                        <button t-if="state.info.production_blocked" class="btn btn-outline-danger" t-att-disabled="state.busy" t-on-click="() =&gt; this.maintenance('enable_production')">Enable production in this database</button>
                    </div>
                </details>
                <p class="text-muted">Keys and certificate retrieval data are encrypted in the database. The private key is never returned to the browser or written to a client key file. Changing company credentials does not require an Odoo restart.</p>
            </t>
        </div>
    </t>
</templates>
