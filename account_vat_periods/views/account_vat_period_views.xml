<odoo>
    <record id="account_vat_period_action" model="ir.actions.act_window">
        <field name="name">VAT Periods</field>
        <field name="res_model">account.vat.period</field>
        <field name="context">{'search_default_this_fiscal_year': 1}</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="account_vat_period_view_tree" model="ir.ui.view">
        <field name="name">account.vat.period.tree</field>
        <field name="model">account.vat.period</field>
        <field name="arch" type="xml">
            <list
                string="VAT Period List"
                create="false"
                edit="false"
                default_order="date_range_id desc"
            >
                <field name="date_range_id" string="VAT Period" />
                <button
                    string="Close"
                    type="object"
                    name="action_do_close"
                    class="btn-secondary"
                    invisible="closeable == True or closed == True"
                />
                <button
                    string="Close"
                    type="object"
                    name="action_do_close"
                    class="btn-success"
                    confirm="Closing this period prevents you from making further changes to it. Are you sure you want to close this period?"
                    invisible="closed == True or closeable == False"
                />
                <button
                    string="Closed"
                    type="object"
                    name="action_do_cancel_close"
                    class="btn-danger"
                    invisible="closed == False"
                />
                <button
                    string="Send Report"
                    type="object"
                    name="action_do_send"
                    class="btn-secondary"
                    invisible="closed == True"
                />
                <button
                    string="Send Report"
                    type="object"
                    name="action_do_send"
                    class="btn-success"
                    invisible="closed == False or (closed == True and sent == True)"
                />
                <button
                    string="Report Sent"
                    type="object"
                    name="action_do_cancel_send"
                    class="btn-danger"
                    invisible="sent == False"
                />
                <button
                    string="Open Report"
                    type="object"
                    name="action_open_report_preview"
                    width="150px"
                />
                <field name="move_id" widget="many2onebutton" />
                <field name="closing_date" width="150px" />
                <field name="vat_payment_type" />
                <field name="payment_move_id" widget="many2onebutton" />
                <field
                    name="payment_state"
                    widget="badge"
                    decoration-danger="payment_state == 'not_paid'"
                    decoration-warning="payment_state in ('partial', 'in_payment')"
                    decoration-success="payment_state in ('paid', 'reversed')"
                    optional="show"
                />
            </list>
        </field>
    </record>

    <record id="account_vat_period_view_search" model="ir.ui.view">
        <field name="name">account.vat.period.search</field>
        <field name="model">account.vat.period</field>
        <field name="arch" type="xml">
            <search string="Properties">
                <filter
                    string="This Fiscal Year"
                    name="this_fiscal_year"
                    domain="[('is_fiscal_start_date', '=', True)]"
                />
            </search>
        </field>
    </record>

    <menuitem
        id="account_vat_period_conf_menu"
        parent="account.menu_finance_entries"
        name="Period Closing"
        sequence="15"
    />
    <menuitem
        id="account_vat_period_menu_action"
        action="account_vat_period_action"
        parent="account_vat_period_conf_menu"
        sequence="10"
    />
</odoo>
