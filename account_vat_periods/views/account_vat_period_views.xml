<odoo>
    <record id="account_vat_period_action" model="ir.actions.act_window">
        <field name="name">VAT Periods</field>
        <field name="res_model">account.vat.period</field>
        <field name="context">{'search_default_this_fiscal_year': 1}</field>
        <field name="view_mode">tree</field> 
    </record>

    <record id="account_vat_period_view_tree" model="ir.ui.view">
        <field name="name">account.vat.period.tree</field>
        <field name="model">account.vat.period</field>
        <field name="arch" type="xml">
            <tree string="VAT Period List" create="false" edit="false" default_order="date_range_id desc">
                <field name="closed" column_invisible="1"/>
                <field name="closeable" column_invisible="1"/>
                <field name="sent" column_invisible="1"/>
                <field name="date_range_id" string="VAT Period"/>
                <button string="Close" type="object" name="action_do_close" class="btn-secondary" invisible="closeable or closed"/>
                <button string="Close" type="object" name="action_do_close" class="btn-success" confirm="Closing this period prevents you from making further changes to it. Are you sure you want to close this period?" invisible="closed or not closeable"/>
                <button string="Closed" type="object" name="action_do_cancel_close" class="btn-danger" invisible="not closed"/>
                <button string="Send Report" type="object" name="action_do_send" class="btn-secondary" invisible="closed"/>
                <button string="Send Report" type="object" name="action_do_send" class="btn-success" invisible="not closed or (closed and sent)"/>
                <button string="Report Sent" type="object" name="action_do_cancel_send" class="btn-danger" invisible="not sent"/>
                <button string="Open Report" type="object" name="action_open_report_preview"></button>
                <field name="move_id" widget="many2onebutton"/>
                <field name="closing_date" width="150px"/>
                <field name="vat_payment_type"/>
                <field name="payment_move_id" widget="many2onebutton"/>
                <field name="payment_state" widget="badge" decoration-danger="payment_state == 'not_paid'" decoration-warning="payment_state in ('partial', 'in_payment')" decoration-success="payment_state in ('paid', 'reversed')"/>
            </tree>
        </field>
    </record>

    <record id="account_vat_period_view_search" model="ir.ui.view">
            <field name="name">account.vat.period.search</field>
            <field name="model">account.vat.period</field>
            <field name="arch" type="xml">
                <search string="Properties">
                    <filter string="This Fiscal Year" name="this_fiscal_year" domain="[('fiscal_year_id.date_from', '&lt;=', context_today().strftime('%Y-%m-%d')), ('fiscal_year_id.date_to', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                </search>
            </field>
    </record>

    <menuitem
        id="account_vat_period_conf_menu"
        parent="account.menu_finance_entries"
        name="Period Closing"
        sequence="15"
    />
    <menuitem
        id="account_vat_period_menu_action"
        action="account_vat_period_action"
        parent="account_vat_period_conf_menu"
        sequence="10"
    />
</odoo>
