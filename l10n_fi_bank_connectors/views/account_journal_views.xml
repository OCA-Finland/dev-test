<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="0">
    <record id="account_statement_import_online.view_account_journal_form" model="ir.ui.view">
        <field name="active">False</field>
    </record>

    <record id="view_account_journal_op_banking_form" model="ir.ui.view">
        <field name="name">account.journal.op.banking.form</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="priority">32</field>
        <field name="arch" type="xml">

            <!-- All accounting users see Bank Feeds radio -->
            <xpath expr="//field[@name='bank_statements_source'][@widget='radio']" position="attributes">
                <attribute name="groups"/>
            </xpath>

            <!-- Expose online_bank_statement_provider_id without group restriction
                 so it can be referenced in modifiers by all users -->
            <xpath expr="//field[@name='bank_statements_source'][@invisible='1']" position="after">
                <field name="online_bank_statement_provider_id" invisible="1"/>
            </xpath>

            <!-- Inject OCA provider group after bank_account_number -->
            <xpath expr="//group[@name='bank_account_number']" position="after">
                <group
                    name="online_bank_statements"
                    string="Online Bank Statements (OCA)"
                    invisible="bank_statements_source != 'online'"
                >
                    <label for="online_bank_statement_provider" string="Provider" class="oe_edit_only"/>
                    <div>
                        <field
                            name="online_bank_statement_provider"
                            nolabel="1"
                            required="bank_statements_source == 'online'"
                            class="oe_inline"
                        />
                        <button
                            name="action_open_online_bank_statement_provider"
                            type="object"
                            string="Configuration"
                            invisible="not online_bank_statement_provider_id"
                        />
                    </div>
                </group>
            </xpath>

            <!-- Pull button in stat button box -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_open_online_bank_statement_provider"
                    type="object"
                    string="Pull Online Bank Statement"
                    class="oe_stat_button"
                    icon="fa-download"
                    invisible="bank_statements_source != 'online' or not online_bank_statement_provider_id"
                />
            </xpath>

        </field>
    </record>
</odoo>