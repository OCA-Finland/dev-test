<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_banking_form" model="ir.ui.view">
        <field name="name">account.payment.banking.form</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">

            <xpath expr="//header" position="inside">
                <button name="action_send_payment"
                        type="object"
                        string="Send to Bank"
                        class="oe_highlight"
                        invisible="banking_payment_status == 'processed' or state not in ('in_process', 'paid')"/>
                <button name="action_check_payment_status"
                        type="object"
                        string="Check Status"
                        invisible="not banking_payment_status or banking_backend_family == 'nordea_corporate_access'"/>
            </xpath>

            <xpath expr="//field[@name='memo']" position="before">
              <field name="payment_reference"
                     string="Payment Reference"
                     placeholder="e.g. RF18539007547034 or 1234561"
                     help="Structured creditor reference — Finnish viitenumero or international RF reference (ISO 11649). If provided, takes priority over the memo field. Leave empty to use memo only."/>
              </xpath>
            <xpath expr="//field[@name='memo']" position="after">
                <field name="banking_connection_id" invisible="1"/>
                <field name="banking_backend_family" invisible="1"/>
                <field name="banking_payment_status"
                    readonly="1"
                    invisible="not banking_payment_status"/>
                <field name="banking_signing_url"
                    readonly="1"
                    widget="url"
                    string="Open to approve payment"
                    invisible="not banking_signing_url"/>
            </xpath>
            <xpath expr="//field[@name='date']" position="attributes">
                <attribute name="help">
                    Requested execution date sent to providers that support it. Nordea Corporate Access defaults to the current UTC date if no date is provided.
                </attribute>
            </xpath>
        </field>
    </record>
</odoo>