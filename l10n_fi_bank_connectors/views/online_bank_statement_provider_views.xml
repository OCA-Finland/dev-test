<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_online_bank_statement_provider_form_inherit"
            model="ir.ui.view">
        <field name="name">online.bank.statement.provider.form.banking</field>
        <field name="model">online.bank.statement.provider</field>
        <field name="inherit_id" ref="account_statement_import_online.online_bank_statement_provider_form"/>
        <field name="arch" type="xml">

            <!-- last_successful_run after service field -->
            <xpath expr="//field[@name='service']" position="after">
                <field name="last_successful_run" readonly="1"/>
            </xpath>

            <!-- cron paused banner + resume button -->
            <xpath expr="//sheet" position="inside">
                <div class="alert alert-warning mb-3"
                     invisible="not cron_paused"
                     role="alert">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <strong>Scheduled pull is paused</strong>
                            <div invisible="cron_pause_reason != 'auth_error'">
                                Bank authorization has expired. Please re-authorize
                                the connection. Transactions since
                                <field name="cron_paused_since" readonly="1" nolabel="1"/>
                                will be fetched automatically after re-authorization.
                            </div>
                            <div invisible="cron_pause_reason != 'consecutive_failures'">
                                Too many consecutive failures. Paused since
                                <field name="cron_paused_since" readonly="1" nolabel="1"/>.
                                <button string="Resume Scheduled Pull"
                                        type="object"
                                        name="action_resume_provider"
                                        class="btn btn-warning mt-2"/>
                            </div>
                        </div>
                    </div>
                </div>

                <field name="cron_paused" invisible="1"/>
                <field name="cron_pause_reason" invisible="1"/>
            </xpath>
        </field>
    </record>

</odoo>