<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_link_partner_bank_wizard_form" model="ir.ui.view">
        <field name="name">link.partner.bank.wizard.form</field>
        <field name="model">link.partner.bank.wizard</field>
        <field name="arch" type="xml">
            <form string="Link Bank Account">

                <field name="existing_partner_bank_id" invisible="1"/>
                <field name="bank_not_found_warning"   invisible="1"/>

                <group string="Account Details">
                    <field name="account_name" readonly="1"/>
                    <field name="iban"         readonly="1"/>
                    <field name="bic"          readonly="1"/>
                </group>

                <group string="Status">
                    <div colspan="2">
                        <field name="status_message" readonly="1" nolabel="1"/>
                    </div>
                </group>

                <!-- BIC not found warning -->
                <div class="alert alert-warning" role="alert"
                     invisible="not bank_not_found_warning">
                    <i class="fa fa-exclamation-triangle me-1"/>
                    BIC <field name="bic" readonly="1" nolabel="1"/> was not found
                    in the bank registry. You can add it manually under
                    Configuration → Banks.
                </div>

                <footer>
                    <button name="action_confirm"
                            type="object"
                            string="Link Bank Account"
                            class="btn-primary"/>
                    <button special="cancel"
                            string="Cancel"
                            class="btn-secondary"/>
                </footer>

            </form>
        </field>
    </record>
</odoo>