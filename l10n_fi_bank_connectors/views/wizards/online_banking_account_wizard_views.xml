<odoo>
<record id="view_online_banking_account_wizard_form" model="ir.ui.view">
    <field name="name">online.banking.account.wizard.form</field>
    <field name="model">online.banking.account.wizard</field>
    <field name="arch" type="xml">
        <form string="Add Banking Account">
            <group>
                <field name="connection_id" invisible="1"/>
                <field name="iban" placeholder="e.g. FI8529501800030574"/>
                <field name="product"/>
            </group>
            <footer>
                <button name="action_save" type="object"
                        string="Save" class="btn-primary"/>
                <button string="Cancel" special="cancel" class="btn-secondary"/>
            </footer>
        </form>
    </field>
</record>
</odoo>
