<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_online_banking_credential_wizard_form" model="ir.ui.view">
        <field name="name">online.banking.credential.wizard.form</field>
        <field name="model">online.banking.credential.wizard</field>
        <field name="arch" type="xml">
            <form string="Set Credential">
                <field name="connection_id" invisible="1"/>
                <field name="credential_type" invisible="1"/>
                <field name="is_pem" invisible="1"/>
                <field name="credential_label" invisible="1"/>
                <group>
                    <field name="is_set" string="Current status" readonly="1"/>
                    <field name="credential_value"
                           string="New value"
                           widget="text"
                           placeholder="Paste value here..."
                           invisible="is_pem"/>
                    <field name="credential_value"
                           string="New value"
                           widget="text"
                           placeholder="-----BEGIN ...-----"
                           invisible="not is_pem"/>
                </group>
                <footer>
                    <button name="action_save"
                            string="Save"
                            type="object"
                            class="btn-primary"
                            data-hotkey="q"/>
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"
                            data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>