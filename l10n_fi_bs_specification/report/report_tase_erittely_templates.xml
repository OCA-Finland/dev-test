<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_tase_erittely" model="ir.actions.report">
        <field name="name">Tase-erittely</field>
        <field name="model">tase.erittely.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_fi_bs_specification.report_tase_erittely</field>
        <field name="report_file">l10n_fi_bs_specification.report_tase_erittely</field>
        <field name="print_report_name">'Tase-erittely - %s' % (object.company_id.name)</field>
        <field name="binding_model_id" eval="False"/>
    </record>

    <template id="report_tase_erittely">
        <t t-call="web.html_container">
            <t t-foreach="account_data" t-as="row">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>
                            Tase-erittely <span t-esc="company.name"/>
                        </h2>
                        <p>
                            Tilikausi <span t-esc="date_from"/> - <span t-esc="date_to"/>
                        </p>
                        <h3>
                            <span t-esc="row['account'].code"/> -
                            <span t-esc="row['account'].name"/>
                        </h3>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Erä</th>
                                    <th class="text-end">Summa</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="row['lines']" t-as="line">
                                    <td><span t-esc="line['label']"/></td>
                                    <td class="text-end">
                                        <span t-esc="line['amount']"
                                              t-options="{'widget': 'monetary', 'display_currency': company.currency_id}"/>
                                    </td>
                                </tr>
                                <tr t-if="not row['lines'] and not row['note']">
                                    <td colspan="2">
                                        <em>Ei erittelyriviä - täydennä manuaalisesti.</em>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <div t-if="row['note']" t-field="row['note']"/>

                        <table class="table table-sm">
                            <tr>
                                <td>Erittelyn summa</td>
                                <td class="text-end">
                                    <span t-esc="row['lines_total']"
                                          t-options="{'widget': 'monetary', 'display_currency': company.currency_id}"/>
                                </td>
                            </tr>
                            <tr>
                                <td>Tilin saldo kirjanpidossa</td>
                                <td class="text-end">
                                    <span t-esc="row['account_balance']"
                                          t-options="{'widget': 'monetary', 'display_currency': company.currency_id}"/>
                                </td>
                            </tr>
                            <tr t-attf-class="{{ 'text-danger fw-bold' if not company.currency_id.is_zero(row['difference']) else '' }}">
                                <td>Erotus</td>
                                <td class="text-end">
                                    <span t-esc="row['difference']"
                                          t-options="{'widget': 'monetary', 'display_currency': company.currency_id}"/>
                                </td>
                            </tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
