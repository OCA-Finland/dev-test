<?xml version='1.0' encoding='UTF-8' ?>
<odoo>
    <!-- Adds fields to hr contract form -->
    <record model="ir.ui.view" id="hr_contract_form_extension_legacy">
        <field name="name">hr.contract.form.extension</field>
        <field name="model">hr.contract</field>
        <field name="inherit_id" ref="hr_contract.hr_contract_view_form" />
        <field name="arch" type="xml">
            <group name="salary_info" position="after">
                <group>
                    <group
                        name="l10n_fi_pre_tax"
                        string="Pre-Tax Benefits"
                        invisible="country_code != 'FI'"
                    >
                        <label for="l10n_fi_benefit_phone" />
                        <div class="o_row mw-50" name="l10n_fi_benefit_phone">
                            <field name="l10n_fi_benefit_phone" nolabel="1" />
                        </div>
                        <label for="l10n_fi_benefit_car" />
                        <div class="o_row mw-50" name="l10n_fi_benefit_car">
                            <field name="l10n_fi_benefit_car" nolabel="1" />
                        </div>
                        <label for="l10n_fi_benefit_apartment" />
                        <div class="o_row mw-50" name="l10n_fi_benefit_apartment">
                            <field name="l10n_fi_benefit_apartment" nolabel="1" />
                        </div>
                        <label for="l10n_fi_benefit_meal" />
                        <div class="o_row mw-50" name="l10n_fi_benefit_meal">
                            <field name="l10n_fi_benefit_meal" nolabel="1" />
                        </div>
                        <label for="l10n_fi_benefit_other" />
                        <div class="o_row mw-50" name="l10n_fi_benefit_other">
                            <field name="l10n_fi_benefit_other" nolabel="1" />
                        </div>
                    </group>
                    <group
                        name="l10n_fi_post_tax"
                        string="Post-Tax Deductions"
                        invisible="country_code != 'FI'"
                    >
                        <label for="l10n_fi_have_membership_fee" />
                        <div class="o_row mw-50" name="l10n_fi_have_membership_fee">
                            <field name="l10n_fi_have_membership_fee" nolabel="1" />
                        </div>
                        <label
                            for="l10n_fi_membership_fee_type"
                            invisible="not l10n_fi_have_membership_fee"
                        />
                        <div
                            class="o_row mw-50"
                            name="l10n_fi__membership_fee_type"
                            invisible="not l10n_fi_have_membership_fee"
                        >
                            <field
                                name="l10n_fi_membership_fee_type"
                                nolabel="1"
                                invisible="not l10n_fi_have_membership_fee"
                            />
                        </div>
                        <label
                            for="l10n_fi_membership_fee_precentage"
                            invisible="l10n_fi_membership_fee_type != 'percentage' or not l10n_fi_have_membership_fee"
                        />
                        <div
                            class="o_row mw-50"
                            name="l10n_fi_membership_fee_precentage"
                            invisible="l10n_fi_membership_fee_type != 'percentage' or not l10n_fi_have_membership_fee"
                        >
                            <field
                                name="l10n_fi_membership_fee_precentage"
                                nolabel="1"
                                invisible="l10n_fi_membership_fee_type != 'percentage' and not l10n_fi_have_membership_fee"
                            />
                        </div>
                        <label
                            for="l10n_fi_membership_fee_fixed"
                            invisible="l10n_fi_membership_fee_type != 'fixed' or not l10n_fi_have_membership_fee"
                        />
                        <div
                            class="o_row mw-50"
                            name="l10n_fi_membership_fee_fixed"
                            invisible="l10n_fi_membership_fee_type != 'fixed' or not l10n_fi_have_membership_fee"
                        >
                            <field
                                name="l10n_fi_membership_fee_fixed"
                                nolabel="1"
                                invisible="l10n_fi_membership_fee_type != 'fixed' or not l10n_fi_have_membership_fee"
                            />
                        </div>
                        <label
                            for="l10n_fi_union"
                            invisible="not l10n_fi_have_membership_fee"
                        />
                        <div
                            class="o_row mw-50"
                            name="l10n_fi_union"
                            invisible="not l10n_fi_have_membership_fee"
                        >
                            <field
                                name="l10n_fi_union"
                                nolabel="0"
                                invisible="not l10n_fi_have_membership_fee"
                            />
                        </div>
                        <label for="l10n_fi_have_distraint" />
                        <div class="o_row mw-50" name="l10n_fi_have_distraint">
                            <field name="l10n_fi_have_distraint" nolabel="1" />
                        </div>
                        <label
                            for="l10n_fi_distraint_income_type"
                            invisible="not l10n_fi_have_distraint"
                        />
                        <div
                            class="o_row mw-50"
                            name="l10n_fi_distraint_have_income"
                            invisible="not l10n_fi_have_distraint"
                        >
                            <field
                                name="l10n_fi_distraint_income_type"
                                nolabel="1"
                                required="l10n_fi_have_distraint"
                            />
                        </div>
                        <label
                            for="l10n_fi_distraint_income_safe"
                            invisible="not l10n_fi_have_distraint"
                        />
                        <div
                            class="o_row mw-50"
                            name="l10n_fi_distraint_income_safe"
                            invisible="not l10n_fi_have_distraint"
                        >
                            <field
                                name="l10n_fi_distraint_income_safe"
                                nolabel="1"
                                required="l10n_fi_have_distraint"
                            />
                        </div>
                        <label
                            for="l10n_fi_distraint_exception"
                            invisible="not l10n_fi_have_distraint"
                        />
                        <div
                            class="o_row mw-50"
                            name="l10n_fi_distraint_exception"
                            invisible="not l10n_fi_have_distraint"
                        >
                            <field name="l10n_fi_distraint_exception" nolabel="1" />
                        </div>
                    </group>
                </group>
            </group>
            <group name="salary_info" position="after">
                <group
                    name="l10n_fi_tax"
                    string="Person Tax"
                    invisible="country_code != 'FI'"
                >
                    <group>
                        <field name="l10n_fi_tax_card_type" />
                        <field name="l10n_fi_base_tax_percentage" widget="percentage" />
                        <field
                            name="l10n_fi_extra_tax_percentage"
                            widget="percentage"
                        />
                    </group>
                    <group>
                        <field name="currency_id" invisible="1" />
                        <field name="l10n_fi_yearly_income_limit" widget="monetary" />
                        <!--<field name="l10n_fi_monthly_income_limit" widget='monetary' /> -->
                        <field
                            name="l10n_fi_yearly_income"
                            widget="monetary"
                            readonly="1"
                        />
                    </group>
                </group>
            </group>
        </field>
    </record>
</odoo>
