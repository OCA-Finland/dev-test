<odoo>
    <record id="view_employee_form_taxcard" model="ir.ui.view">
        <field name="name">hr.employee.form.taxcard.history</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@class='oe_button_box']" position="inside">
                <button name="%(action_hr_taxcard_history)d"
                        type="action"
                        class="oe_stat_button"
                        icon="fa-percent">
                    <div class="o_stat_info">
                        <span>Verokortit</span>
                    </div>
                </button>
            </xpath>
          <!--  <xpath expr="//header" position="inside">
                <button name="%(action_hr_taxcard_history)d" type="action" icon="fa-percent" string="Verokortit"/>
            </xpath> -->
        </field>
    </record>
</odoo>