<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record model="ir.ui.view" id="hr_payslip_view_list_inherit">
        <field name="name">hr.payslip.view.list.inherit.income.register</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="payroll.hr_payslip_view_tree" />
        <field name="arch" type="xml">
            <field name="state" position="after">
                <field
                    name="l10n_fi_ir_report_download"
                    string="IR Report"
                    optional="show"
                    widget="html"
                    column_invisible="context.get('hide_ir_column', False)"
                />
            </field>

            <field name="state" position="after">
                <field
                    name="exception_warning_state"
                    string="Exception"
                    optional="show"
                    widget="badge"
                    decoration-danger="exception_warning_state"
                />
            </field>
        </field>
    </record>

    <record id="action_payslip_generate_ir_report" model="ir.actions.server">
        <field name="name">Generate IR Report</field>
        <field name="model_id" ref="payroll.model_hr_payslip" />
        <field name="binding_model_id" ref="payroll.model_hr_payslip" />
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
if records:
    action = records.action_incomes_register_report()
        </field>
    </record>
</odoo>
