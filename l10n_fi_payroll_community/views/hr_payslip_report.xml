<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <template id="report_payslip_orig">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2 id="payslip_name"><span t-field="o.name">August 2023 Payslip</span></h2>
                    <t t-set="is_invalid" t-value="o._is_invalid()"/>
                    <div t-if="is_invalid">
                        <strong id="invalid_warning"><span t-out="is_invalid">This payslip is not validated. This is not
                            a legal document.</span></strong>
                    </div>
                    <div t-else="">
                        <div class="oe_structure"></div>
                    </div>
                    <div id="infos_table">
                        <table class="table table-sm table-borderless">
                            <thead class="o_black_border">
                                <tr>
                                    <th>Employee Information</th>
                                    <th>Other Information</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td id="employee_infos">
                                        <div id="employee_name">
                                            <strong class="me-2">Name:</strong>
                                            <span t-field="o.employee_id.legal_name"/>
                                        </div>
                                        <div id="employee_id">
                                            <strong class="me-2">ID:</strong>
                                            <span t-if="o.employee_id.identification_id"
                                                  t-field="o.employee_id.identification_id"/>
                                            <span t-else="" style="color:#875A7B" class="fw-bold">No ID number on the
                                                employee !!!</span>
                                        </div>
                                        <div id="employee_email" t-if="o.employee_id.work_email">
                                            <strong class="me-2">Email:</strong>
                                            <span t-field="o.employee_id.work_email"/>
                                        </div>
                                        <div id="employee_job_title" t-if="o.employee_id.job_title">
                                            <strong class="me-2">Job Position:</strong>
                                            <span t-field="o.employee_id.job_title"/>
                                        </div>
                                        <div id="employee_department" t-if="o.employee_id.department_id">
                                            <strong class="me-2">Department:</strong>
                                            <span t-field="o.employee_id.department_id"/>
                                        </div>
                                        <div id="employee_marital">
                                            <strong class="me-2">Marital Status:</strong>
                                            <span t-field="o.employee_id.marital"/>
                                        </div>
                                        <div id="employee_person_in_charge" t-if="o.employee_id.children">
                                            <strong class="me-2">Children:</strong>
                                            <span t-field="o.employee_id.children"/>
                                        </div>
                                        <div id="employee_private_address"
                                             t-if="o.employee_id.private_street and o.employee_id.private_city">
                                            <strong class="me-2">Address:</strong>
                                            <span t-field="o.employee_id.private_street"/>,
                                            <span t-field="o.employee_id.private_street2"
                                                  t-if="o.employee_id.private_street2" class="ms-2"/><span
                                                t-if="o.employee_id.private_street2">,</span>
                                            <span t-field="o.employee_id.private_city" class="ms-2"/>
                                            <span t-field="o.employee_id.private_zip"/>
                                            <span t-field="o.employee_id.private_country_id"/>
                                        </div>
                                    </td>
                                    <td id="other_infos">
                                        <div id="wage">
                                            <strong class="me-2">Contract Wage (<span class="text-capitalize"
                                                                                      t-out="o.contract_id.wage_type"/>
                                                ):</strong>
                                            <span t-out="o.contract_id._get_contract_wage()"
                                                  t-options="{'widget': 'monetary', 'display_currency': o.company_id.currency_id}"
                                                  style="color:#875A7B" class="fw-bold"/>
                                        </div>
                                        <div id="pay_period">
                                            <strong class="me-2">Pay Period:</strong>
                                            <span t-if="o.date_from &lt; o.contract_id.date_start"
                                                  t-field="o.contract_id.date_start"/>
                                            <span t-else="" t-field="o.date_from"/>
                                            -
                                            <span t-if="o.contract_id.date_end and o.date_to &gt; o.contract_id.date_end"
                                                  t-field="o.contract_id.date_end"/>
                                            <span t-else="" t-field="o.date_to"/>
                                        </div>
                                        <div id="computed_on">
                                            <strong class="me-2">Computed On:</strong>
                                            <span t-field="o.compute_date"/>
                                        </div>
                                        <div id="contract_start">
                                            <strong class="me-2">Contract Start Date:</strong>
                                            <span t-field="o.employee_id.first_contract_date"/>
                                        </div>
                                        <div id="contract_type" t-if="o.contract_id.contract_type_id">
                                            <strong class="me-2">Contract Type:</strong>
                                            <span t-field="o.employee_id.contract_id.contract_type_id"/>
                                        </div>
                                        <div id="working_schedule">
                                            <strong class="me-2">Working Schedule:</strong>
                                            <span t-field="o.employee_id.contract_id.hours_per_week"/> Hours / Week
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div id="worked_days_table">
                        <table class="table table-sm table-borderless">
                            <thead class="o_black_border">
                                <tr>
                                    <th id="work_days_header_name">Earnings</th>
                                    <th id="work_days_header_hours" class="text-end">Hours</th>
                                    <th id="work_days_header_days" class="text-end">Days</th>
                                    <th id="work_days_header_amount" class="text-end">Amount</th>
                                    <th id="work_days_header_ytd" t-if="o.ytd_computation" class="text-end">YTD</th>
                                </tr>
                            </thead>
                            <tbody id="worked_days_lines">
                                <t t-set="worked_days_lines"
                                   t-value="o.worked_days_line_ids.filtered(lambda worked_days: worked_days.code != 'OUT')"/>
                                <span t-foreach="worked_days_lines" t-as="worked_days">
                                    <tr style="color:none">
                                        <td id="worked_days_name"><span t-field="worked_days.name"/></td>
                                        <td id="worked_days_hours" class="text-end"><span
                                                t-out="round(worked_days.number_of_hours, 2)"/></td>
                                        <td id="worked_days_days" class="text-end"><span
                                                t-out="round(worked_days.number_of_days, 2)"/></td>
                                        <td id="worked_days_amount" class="text-end"><span t-out="worked_days.amount"
                                                                                           digits="[42, 2]"
                                                                                           t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/></td>
                                        <td id="worked_days_ytd" t-if="o.ytd_computation" class="text-end">
                                            <span t-esc="worked_days.ytd"
                                                  t-options="{'widget': 'monetary', 'display_currency': o.company_id.currency_id}"/>
                                        </td>
                                    </tr>
                                </span>
                                <span>
                                    <t t-set="line_style" t-value="'color:#875A7B;'"/>
                                    <t t-set="line_class" t-value="'o_total o_border_bottom fw-bold'"/>
                                    <tr style="color:none">
                                        <td t-att-class="line_class" t-att-style="line_style">
                                            <span>Total</span>
                                        </td>
                                        <td id="worked_days_total_hours" t-attf-class="#{line_class} text-end"
                                            t-att-style="line_style">
                                            <span t-out="round(sum(worked_days_lines.mapped('number_of_hours')), 2)"/>
                                        </td>
                                        <td id="worked_days_total_days" t-attf-class="#{line_class} text-end"
                                            t-att-style="line_style">
                                            <span t-out="round(sum(worked_days_lines.mapped('number_of_days')), 2)"/>
                                        </td>
                                        <td id="worked_days_total_amount" t-attf-class="#{line_class} text-end"
                                            t-att-style="line_style">
                                            <span t-out="sum(worked_days_lines.mapped('amount'))" digits="[42, 2]"
                                                  t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/>
                                        </td>
                                        <td id="worked_days_total_ytd" t-if="o.ytd_computation"
                                            t-attf-class="#{line_class} text-end" t-att-style="line_style">
                                            <span t-out="sum(worked_days_lines.mapped('ytd'))" digits="[42, 2]"
                                                  t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/>
                                        </td>
                                    </tr>
                                </span>
                            </tbody>
                        </table>
                    </div>
                    <div id="payslip_lines_table">
                        <table class="table table-sm table-borderless">
                            <thead class="o_black_border">
                                <tr>
                                    <th id="line_header_name">Name</th>
                                    <th id="line_header_amount" class="text-end">Amount</th>
                                    <th id="line_header_quantity" class="text-end">Quantity</th>
                                    <th id="line_header_rate" class="text-end">Rate</th>
                                    <th id="line_header_total" class="text-end">Total</th>
                                    <th id="line_header_ytd" class="text-end" t-if="o.ytd_computation">YTD</th>
                                </tr>
                            </thead>
                            <tbody id="payslip_lines">
                                <span t-foreach="o.line_ids.filtered(lambda line: line.appears_on_payslip)" t-as="line">
                                    <t t-set="line_styling" t-value="line.get_payslip_styling_dict()"/>
                                    <t t-set="line_style"/>
                                    <t t-set="line_class"/>
                                    <t t-if="line.code in line_styling">
                                        <t t-set="line_style" t-value="line_styling[line.code]['line_style']"/>
                                        <t t-set="line_class" t-value="line_styling[line.code]['line_class']"/>
                                    </t>
                                    <tr id="line_display">
                                        <td id="payslip_line_name" t-att-class="line_class"
                                            t-att-style="line_style"><span t-field="line.name"/></td>
                                        <td id="payslip_line_amount" t-attf-class="#{line_class} text-end"
                                            t-att-style="line_style">
                                            <span t-out="line.amount"
                                                  t-if="line.quantity > 1 or line.rate &lt; 100"
                                                  t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'
                                                  t-att-style="'color:#875A7B;' if line.amount &lt; 0 else ''"/>
                                        </td>
                                        <td id="payslip_line_quantity" t-attf-class="#{line_class} text-end"
                                            t-att-style="line_style">
                                            <span t-if="line.quantity > 1" t-out="round(line.quantity, 2)"
                                                  t-att-style="'color:#875A7B;' if line.quantity &lt; 0 else ''"/>
                                        </td>
                                        <td id="payslip_line_rate" t-attf-class="#{line_class} text-end"
                                            t-att-style="line_style">
                                            <span t-if="line.rate &lt; 100" t-out="str(round(line.rate, 2)) + ' %'"
                                                  t-att-style="'color:#875A7B;' if line.rate &lt; 0 else ''"></span>
                                        </td>
                                        <td id="payslip_line_total" t-attf-class="#{line_class} text-end"
                                            t-att-style="line_style">
                                            <span t-out="line.total"
                                                  t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'
                                                  t-att-style="'color:#875A7B;' if line.total &lt; 0 else ''"/>
                                        </td>
                                        <td id="payslip_line_ytd" t-if="o.ytd_computation" class="text-end">
                                            <span t-esc="line.ytd"
                                                  t-options="{'widget': 'monetary', 'display_currency': o.company_id.currency_id}"
                                                  t-att-style="'color:#875A7B;' if line.ytd &lt; 0 else ''"/>
                                        </td>
                                    </tr>
                                </span>
                            </tbody>
                        </table>
                        <div class="oe_structure"></div>
                    </div>
                    <div id="to_pay">
                        <p t-if="o.net_wage &gt;= 0">To pay on <b><span t-field="o.employee_id.bank_account_id">
                            xxxxxxxxxxxx</span></b> of <i><span t-field="o.employee_id.legal_name"/></i>: <span
                                t-field="o.net_wage" class="fw-bold"/></p>
                        <p t-if="o.net_wage &lt; 0">The net amount will be recovered from the first positive
                            remuneration established after this.</p>
                    </div>
                </div>
            </t>
        </template>


        <template inherit_id="report_payslip_orig" id="report_payslip_inherit">
            <xpath expr="//td[@id='employee_infos']" position="replace">
                <td id="employee_infos">
                    <table>
                        <tbody>
                            <tr id="employee_name">
                                <td><strong class="me-2">Vastaanottaja:</strong></td>
                                <td><span t-field="o.employee_id.legal_name"/></td>
                            </tr>
                            <tr id="employee_birthday">
                                <td><strong class="me-2">Syntymäaika:</strong></td>
                                <td><span t-field="o.employee_id.birthday"/></td>
                            </tr>
                            <tr id="employee_id">
                                <td><strong class="me-2">Henkilötunnus:</strong></td>
                                <td>
                                    <span t-if="o.employee_id.ssnid"
                                          t-field="o.employee_id.ssnid"/>
                                    <span t-else="" style="color:#875A7B" class="fw-bold">No ID number on the employee
                                        !!!</span>
                                </td>
                            </tr>
                            <tr id="employee_private_address"
                                t-if="o.employee_id.private_street and o.employee_id.private_city">
                                <td><strong class="me-2">Osoite:</strong></td>
                                <td>
                                    <span t-field="o.employee_id.private_street"/>,<br/>
                                    <span t-if="o.employee_id.private_street2">,</span>
                                    <span t-field="o.employee_id.private_city"/>
                                    <span t-field="o.employee_id.private_zip"/>
                                    <span t-field="o.employee_id.private_country_id"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </td>
            </xpath>
            <xpath expr="//td[@id='other_infos']" position="replace">
                <td id="other_infos">
                    <table>
                        <tbody>
                            <tr id="pay_period">
                                <td><strong class="me-2">Palkkajakso:</strong></td>
                                <td>
                                    <span t-if="o.date_from &lt; o.contract_id.date_start"
                                          t-field="o.contract_id.date_start"/>
                                    <span t-else="" t-field="o.date_from"/> -
                                    <span t-if="o.contract_id.date_end and o.date_to &gt; o.contract_id.date_end"
                                          t-field="o.contract_id.date_end"/>
                                    <span t-else="" t-field="o.date_to"/>
                                </td>
                            </tr>
                            <tr id="computed_on">
                                <td><strong class="me-2">Maksupäivä:</strong></td>
                                <td><span t-field="o.compute_date"/></td>
                            </tr>
                            <tr id="contract_start">
                                <td><strong class="me-2">Työsuhteen alkupvm.:</strong></td>
                                <td><span t-field="o.employee_id.first_contract_date"/></td>
                            </tr>
                            <tr id="contract_ytd">
                                <td><strong class="me-2">Verokortin tulot:</strong></td>
                                <td>
                                    <span t-field="o.employee_id.l10n_fi_yearly_income"
                                          t-options="{'widget': 'monetary', 'display_currency': o.company_id.currency_id}"/>
                                </td>
                            </tr>
                            <tr id="tax_card">
                                <td><strong class="me-2">Verokortti:</strong></td>
                                <td>
                                    <table>
                                        <tr t-if="o.contract_id.l10n_fi_yearly_income_limit">
                                            <td style="text-align: left;">
                                                0 - <span t-field="o.contract_id.l10n_fi_yearly_income_limit"
                                                          t-options="{'widget': 'monetary', 'display_currency': o.company_id.currency_id}"/>
                                            </td>
                                            <td style="text-align: right;padding-left: 10px;">
                                                <span t-out="str(o.contract_id.l10n_fi_base_tax_percentage * 100) + ' %'"/>
                                            </td>
                                        </tr>
                                        <tr t-if="o.contract_id.l10n_fi_extra_tax_percentage">
                                            <td style="text-align: left;">
                                                <span t-field="o.contract_id.l10n_fi_yearly_income_limit"
                                                      t-options="{'widget': 'monetary', 'display_currency': o.company_id.currency_id}"/>
                                                -
                                            </td>
                                            <td style="text-align: right; padding-left: 10px;">
                                                <span t-out="str(o.contract_id.l10n_fi_extra_tax_percentage * 100) + ' %'"/>
                                            </td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </td>
            </xpath>
            <xpath expr="//div[@id='payslip_lines_table']" position="replace">
                <div id="payslip_lines_table">
                    <table class="table table-sm table-borderless">
                        <thead class="o_black_border">
                            <tr>
                                <th id="line_header_name" colspan="2">Palkkalaji - Selite</th>
                                <th id="line_header_quantity" class="text-end">Määrä/Kerroin</th>
                                <th id="line_header_total" class="text-end">Summa</th>
                                <th id="line_header_ytd" class="text-end" t-if="o.ytd_computation">Vuoden alusta</th>
                            </tr>
                        </thead>
                        <tbody id="payslip_lines">
                            <span t-foreach="o.line_ids.filtered(lambda line: line.appears_on_payslip and (line.ytd or line.total))"
                                  t-as="line">
                                <t t-set="line_styling" t-value="line.get_payslip_styling_dict()"/>
                                <t t-set="line_style"/>
                                <t t-set="line_class"/>
                                <t t-if="line.code in line_styling">
                                    <t t-set="line_style" t-value="line_styling[line.code]['line_style']"/>
                                    <t t-set="line_class" t-value="line_styling[line.code]['line_class']"/>
                                </t>
                                <tr id="line_display">
                                    <td id="payslip_line_code" t-att-class="line_class" t-att-style="line_style">
                                        <span t-field="line.l10n_fi_code"/>
                                    </td>
                                    <td id="payslip_line_name" t-att-class="line_class" t-att-style="line_style">
                                        <span t-field="line.name"/>
                                    </td>
                                    <td id="payslip_line_quantity" t-attf-class="#{line_class} text-end"
                                        t-att-style="line_style">
                                        <span t-if="line.quantity > 1" t-out="round(line.quantity, 2)"
                                              t-att-style="'color:#875A7B;' if line.quantity &lt; 0 else ''"/>
                                        <span t-if="line.aggregated_amount"
                                              t-out="'%s %s' % (line.aggregated_amount, line.aggregated_uom_id.name)"/>
                                        <span t-if="line.rate &lt; 100" t-out="' * ' + str(round(line.rate, 2)) + ' %'"
                                              t-att-style="'color:#875A7B;' if line.rate &lt; 0 else ''"></span>
                                    </td>
                                    <td id="payslip_line_total" t-attf-class="#{line_class} text-end"
                                        t-att-style="line_style">
                                        <span t-out="line.total"
                                              t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'
                                              t-att-style="'color:#875A7B;' if line.total &lt; 0 else ''"/>
                                    </td>
                                    <td id="payslip_line_ytd" t-if="o.ytd_computation" class="text-end">
                                        <span t-esc="line.ytd"
                                              t-options="{'widget': 'monetary', 'display_currency': o.company_id.currency_id}"
                                              t-att-style="'color:#875A7B;' if line.ytd &lt; 0 else ''"/>
                                    </td>
                                </tr>
                            </span>
                        </tbody>
                    </table>
                    <div class="oe_structure"></div>
                </div>
            </xpath>
            <xpath expr="//div[@id='worked_days_table']" position="replace"/>
        </template>
    </data>
</odoo>
