<?xml version='1.0' encoding='UTF-8' ?>
<odoo>
    <record model="ir.ui.view" id="hr_salary_rule_view_form">
        <field name="name">hr.payslip.rule.form.inherit</field>
        <field name="model">hr.salary.rule</field>
        <field name="inherit_id" ref="payroll.hr_salary_rule_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='principal']" position="inside">
                <group string="Aggregations">
                    <field name="aggregate_input_type_ids" />
                    <field name="aggregated_uom_id" />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
