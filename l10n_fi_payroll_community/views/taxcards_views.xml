<?xml version='1.0' encoding='UTF-8' ?>
<odoo>
    <!-- Action -->
    <record id="action_hr_taxcard_history" model="ir.actions.act_window">
        <field name="name">Verokortit</field>
        <field name="res_model">hr.taxcards</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('employee_id', '=', active_id)]</field>
        <field name="context">{'default_employee_id': active_id}</field>
    </record>
    <!-- List View -->
    <record id="view_taxcard_history_list" model="ir.ui.view">
        <field name="name">hr.taxcards.list</field>
        <field name="model">hr.taxcards</field>
        <field name="arch" type="xml">
            <list string="Verokortit" default_order="date desc">
                <field name="employee_id" />
                <field name="date" />
                <field name="tax_percentage" />
                <field name="additional_percentage" />
                <field name="income_limit" />
                <field name="entry_type" />
            </list>
        </field>
    </record>
    <!-- Form View -->
    <record id="view_taxcard_history_form" model="ir.ui.view">
        <field name="name">hr.taxcards.form</field>
        <field name="model">hr.taxcards</field>
        <field name="arch" type="xml">
            <form string="Verokortti">
                <sheet>
                    <group>
                        <field name="employee_id" />
                        <field name="date" />
                        <field name="tax_percentage" />
                        <field name="additional_percentage" />
                        <field name="income_limit" />
                        <field name="entry_type" />
                        <field name="notes" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
