<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="ir_cron_certificate_expiry" model="ir.cron">
        <field name="name">Incomes Register: certificate expiry</field>
        <field name="model_id" ref="model_l10n_fi_ir_backend" />
        <field name="state">code</field>
        <field name="code">model._cron_certificate_expiry()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True" />
    </record>
    <record id="ir_cron_ir_poll" model="ir.cron">
        <field name="name">Incomes Register: poll delivery status</field>
        <field name="model_id" ref="model_l10n_fi_ir_submission" />
        <field name="state">code</field>
        <field name="code">model._cron_poll()</field>
        <field name="interval_number">2</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True" />
    </record>
</odoo>
