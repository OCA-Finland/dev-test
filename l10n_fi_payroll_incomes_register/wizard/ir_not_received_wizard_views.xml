<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="l10n_fi_ir_not_received_wizard_view_form" model="ir.ui.view">
        <field name="name">l10n_fi.ir.not.received.wizard.form</field>
        <field name="model">l10n_fi.ir.not.received.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="submission_id" invisible="1" />
                    <field name="note" placeholder="What did you check?" />
                </group>
                <footer>
                    <button
                        name="action_confirm"
                        type="object"
                        string="Mark as not received"
                        class="btn-primary"
                    />
                    <button string="Cancel" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
