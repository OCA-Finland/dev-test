<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="l10n_fi_ir_send_wizard_view_form" model="ir.ui.view">
        <field name="name">l10n_fi.ir.send.wizard.form</field>
        <field name="model">l10n_fi.ir.send.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="environment" />
                    <field name="delivery_count" />
                    <field name="payslip_ids" widget="many2many_tags" />
                </group>
                <group invisible="not skipped_message">
                    <field name="skipped_message" />
                </group>
                <group invisible="not warning_message">
                    <field name="warning_message" />
                </group>
                <group>
                    <field name="preview_xml" />
                </group>
                <footer>
                    <button
                        name="action_confirm"
                        type="object"
                        string="Send"
                        class="btn-primary"
                    />
                    <button string="Cancel" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
