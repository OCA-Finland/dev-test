<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- account_move -->
    <record id="view_move_form_inherit_bank_barcode" model="ir.ui.view">
        <field name="name">account.move.form.bank.barcode</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='fiscal_position_id']" position="after">
                <field name="bank_barcode" readonly="1" invisible="not bank_barcode"/>
            </xpath>
        </field>
    </record>

    <!-- ir_actions_report -->
    <record id="act_report_xml_view_inherit_report_invoice_community_settings" model="ir.ui.view">
        <field name="name">ir.actions.report.view.form.report.invoice.community.settings</field>
        <field name="model">ir.actions.report</field>
        <field name="inherit_id" ref="base.act_report_xml_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='advanced']" position="inside">
                <group string="Bank Transfer Form Settings" invisible="model != 'account.move'">
                    <field name="show_bank_transfer_form"/>
                    <field name="show_bank_transfer_barcode" invisible="not show_bank_transfer_form"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>